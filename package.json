{
  "name": "job-mail-automation",
  "version": "1.0.0",
  "description": "Self-hosted cold-outreach mailer for job hunting: reads contacts from a Google Sheet, sends from your own Gmail (SMTP or Gmail API), tracks bounces, writes status back to the sheet.",
  "keywords": ["job-search", "cold-email", "gmail-api", "google-sheets", "automation", "outreach"],
  "license": "MIT",
  "author": "Aditi Sharma",
  "repository": {
    "type": "git",
    "url": "https://github.com/aditisharma32/job_mail_automation.git"
  },
  "bugs": "https://github.com/aditisharma32/job_mail_automation/issues",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "send": "node scripts/runOnce.js",
    "bounces": "node scripts/processBounces.js",
    "google-token": "node scripts/getGoogleToken.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "imapflow": "^1.0.0",
    "mailparser": "^3.7.0",
    "nodemailer": "^6.9.16"
  }
}
